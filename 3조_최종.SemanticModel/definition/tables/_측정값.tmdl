	measure '온열질환 차이 문구' =
			
			VAR DifferenceValue =
			    [온열질환 전국 대비 차이]
			RETURN
			    "전국 대비 "
			        & IF(DifferenceValue >= 0, "+", "")
			        & FORMAT(DifferenceValue, "0%")
		lineageTag: d74e6214-d257-4dae-96c1-f092c6e065a9

	measure '고령인구 차이 문구' =
			
			VAR DifferenceValue =
			    [고령인구 전국 대비 차이]
			RETURN
			    "전국 대비 "
			        & IF(DifferenceValue >= 0, "+", "")
			        & FORMAT(DifferenceValue, "0%")
		lineageTag: 6d49fb11-ee6d-4213-9b92-f6234b5de1b9

	measure '쉼터 부족 문구' =
			
			VAR DifferenceValue =
			    [쉼터 대응 부족률]
			RETURN
			    IF(
			        DifferenceValue >= 0,
			        "전국 대비 " & FORMAT(DifferenceValue, "0%") & " 부족",
