	measure '최다 발생일 환자수' = ```
			
			MAXX(
			    VALUES('캘린더'[날짜]),
			    CALCULATE(SUM('날짜별_온열질환'[온열질환자수]))
			)
			
			```
		formatString: 0
		lineageTag: 796bb51c-f7c9-45af-b028-5131021aeb00

	measure '환자 최다 발생일' =
			
			VAR MaxPatients =[최다 발생일 환자수]
			RETURN
			MAXX(
			    FILTER(
			        VALUES('캘린더'[날짜]),
			        CALCULATE(SUM('날짜별_온열질환'[온열질환자수])) = MaxPatients
			    ),
			    '캘린더'[날짜]
			)
		formatString: yyyy-mm-dd
		lineageTag: f6a1eed7-5d62-4ca2-85a9-4e7071dbeacd

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure '전체 시군구 수' =
			
			DISTINCTCOUNT('시군구'[시군구코드])
		formatString: 0
		lineageTag: 6c3a9141-0ae7-4fde-a4a2-cc83a4a5ad2d

	measure '현재 사각지대 수' =
			
			CALCULATE(
			    [전체 시군구 수],
			    '시군구'[사각지대 유형] = "현재 사각지대"
			)
		formatString: 0
		lineageTag: c7814098-39aa-4e96-96b0-b90d44dee371

	measure '잠재 사각지대 수' =
			
			CALCULATE(
			    [전체 시군구 수],
			    '시군구'[사각지대 유형] = "잠재 사각지대"
			)
		formatString: 0
		lineageTag: 5d21bba6-5bfc-47e6-90a1-641cbd667342

	measure '피해 집중지역 수' =
			
			CALCULATE(
			    [전체 시군구 수],
			    '시군구'[사각지대 유형] = "피해 집중지역"
			)
		formatString: 0
		lineageTag: 7a13dc3c-e024-40d2-ba3c-67f5927ce817

	measure '사각지대 후보 수' =
			
			[현재 사각지대 수] + [잠재 사각지대 수]
		formatString: 0
		lineageTag: 1f5ff148-3849-4507-959d-e159848c2293

	measure '선택 시군구' =
			
			SELECTEDVALUE(
			    '시군구'[시군구],
			    "-"
			)
		lineageTag: d2dac5fd-ef3a-479e-90ea-55aba3c85f86

	measure '지역별 폭염일수 최댓값' =
			
			MAX('시군구'[분석_폭염일수])
		formatString: 0
		lineageTag: 26158128-52ca-477a-a0c7-b59fc6b4cb11

	measure '폭염 발생지역 수' =
			
			CALCULATE(
			    DISTINCTCOUNT('시군구'[시군구코드]),
			    '시군구'[분석_폭염일수] > 0
			)
		formatString: 0
		lineageTag: ad39641b-b1d4-4457-9427-f4b85aa9eab1

	measure 발생률_중앙값 =
			
			MEDIANX(
			    VALUES('시군구'[시군구코드]),
			    [온열질환 발생률(10만명당)]
			)
		lineageTag: f1680748-3600-4b56-826f-f8e13cd186e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '폭염 사각지대 지역 수' =
			
			CALCULATE(
			    DISTINCTCOUNT('시군구'[시군구코드]),
			    '시군구'[사각지대 유형] IN {
			        "현재 사각지대",
			        "잠재 사각지대"
			    }
			)
		formatString: 0
		lineageTag: 1f149b80-4861-4660-a0d8-bdfad8ed6c0d

	measure '전체 지역 수' =
			
			CALCULATE(
			    DISTINCTCOUNT('시군구'[시군구코드]),
			    REMOVEFILTERS('시군구'[사각지대 유형])
			)
		formatString: 0
		lineageTag: 5e85c2bd-0f6f-43ff-84eb-6849d1156f9d

	measure '폭염 사각지대 지역 비율' =
			
			DIVIDE(
			    [폭염 사각지대 지역 수],
			    [전체 지역 수],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5de76de3-8f12-4d85-a54a-90323b9e6e62

	measure '선택 유형 온열질환자 비중' =
			
			DIVIDE(
			    [총 온열질환자수],
			    CALCULATE(
			        [총 온열질환자수],
			        REMOVEFILTERS('시군구'[사각지대 유형])
