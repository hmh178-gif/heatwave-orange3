	measure '전국 평균 온열질환 발생률' =
			
			AVERAGEX(
			    FILTER(
			        ALL('시군구'),
			        NOT ISBLANK('시군구'[온열질환 발생률_열])
			    ),
			    '시군구'[온열질환 발생률_열]
