	measure 주거관련환자수 = SUM('폭염_온열질환자'[실외_주거지주변]) + SUM('폭염_온열질환자'[실내_집])
		formatString: 0
		lineageTag: a37f487b-93e1-4574-8e04-3332c8198259

	measure 전년온열질환자수 =
			
			CALCULATE(
			    [온열질환자수],
			    FILTER(ALL('폭염_온열질환자'[기준연도]),
			        '폭염_온열질환자'[기준연도] = MAX('폭염_온열질환자'[기준연도]) - 1)
			)
		formatString: 0
		lineageTag: 93d1ec3e-b527-428e-90f9-0a06b809704f

	measure 전년대비증감 = [온열질환자수] - [전년온열질환자수]
		formatString: 0
		lineageTag: 09c6e411-285d-461c-bd69-23cee6f9d786

	measure 전년대비증감률 = DIVIDE([전년대비증감], [전년온열질환자수])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 35f9fa93-a313-4445-b797-1b389fcfeca9

	measure 5년평균환자수 = CALCULATE(AVERAGE('폭염_온열질환자'[전체]), ALL('폭염_온열질환자'[기준연도]))
