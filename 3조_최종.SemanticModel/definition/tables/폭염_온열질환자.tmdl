		lineageTag: 433f20ec-125e-4ea9-9e61-f98a7d3da918

	measure 작업장환자수 = SUM('폭염_온열질환자'[실외_작업장]) + SUM('폭염_온열질환자'[실내_작업장])
		formatString: 0
